# Copy this file to `.env` and fill in your real values before running `docker compose up`.

# JWT signing secret (any long random string)
JWT_SEC=change_me_to_a_long_random_string

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini API key (https://aistudio.google.com/app/apikey)
API_KEY_GEMINI=your_gemini_api_key

# Razorpay keys (https://dashboard.razorpay.com/app/keys)
Razorpay_Key=your_razorpay_key_id
Razorpay_Secret=your_razorpay_key_secret

# Public URL the browser uses to reach the backend API
VITE_SERVER_URL=http://localhost:5000
